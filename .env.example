# ==============================================================================
# PH DIGITAL EDUCATION — PRODUCTION ENVIRONMENT CONFIGURATION
# File: .env.example  ← copy thành .env rồi điền giá trị thật
# ==============================================================================

# ── 1. DATABASE — MySQL trên DirectAdmin (IP: 103.82.20.110) ──
DB_HOST=103.82.20.110
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name
DATABASE_URL="mysql://your_mysql_username:your_mysql_password@103.82.20.110:3306/your_database_name"

# ── 2. SECURITY & SESSION AUTHENTICATION (SERVER-ONLY) ──
AUTH_SECRET="your-super-secret-hmac-sha256-key-min-32-chars"
SESSION_SECRET="your-session-cookie-encryption-secret"
# This project uses a custom Vercel session cookie, not NextAuth.
# NEXTAUTH_SECRET and NEXTAUTH_URL are intentionally not read by this codebase.

# ── 3. AI LEARNING ASSISTANT (GOOGLE GEMINI API) ──
GEMINI_API_KEY="your-google-gemini-api-key"

# ── 4. PRODUCTION URLS ──
APP_URL="https://hoctructuyen.tinhocgenz.io.vn"
VITE_APP_URL="https://hoctructuyen.tinhocgenz.io.vn"

# ── 5. ZALO OPENAPI & ZBS OFFICIAL INTEGRATION (SERVER-ONLY) ──
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_ZBS_TEMPLATE_ID=

# ── 6. FEATURE FLAGS & SAFETY CONTROLS ──
ZALO_INTEGRATION_ENABLED=true
ZALO_SEND_ENABLED=false
ZALO_AUTOMATION_ENABLED=false

# ── 7. SUPABASE BACKEND (SERVERLESS ADMIN) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 8. VERCEL CRON PROTECTION ──
CRON_SECRET=

# 9. WEB PUSH (server-only; required by notification cron/routes)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@tinhocgenz.io.vn"

# 10. OPTIONAL SERVER FEATURES
CERT_SECRET_KEY=
LEARNING_SYNC_CRON_SECRET=
LEARNING_SOURCE_HUB_ENABLED=true
MONTHLY_SOURCE_SYNC_ENABLED=true

# ── 11. CLIENT-SIDE SUPABASE (PUBLIC ANON KEYS ONLY) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 12. OPTIONAL WEBHOOK MIRROR FOR SRE / DEVOPS MONITORING ──
WEBHOOK_FORWARD_URL=
