# ==============================================================================
# PH DIGITAL EDUCATION — PRODUCTION ENVIRONMENT CONFIGURATION
# File: .env.example
# ==============================================================================

# ── 1. DATABASE & PRISMA ORM (POSTGRESQL) ──
DATABASE_URL="postgresql://postgres:password@localhost:5432/tinhocgenz_lms?schema=public"

# ── 2. SECURITY & SESSION AUTHENTICATION (SERVER-ONLY) ──
AUTH_SECRET="your-super-secret-hmac-sha256-key-min-32-chars"
SESSION_SECRET="your-session-cookie-encryption-secret"

# ── 3. AI LEARNING ASSISTANT (GOOGLE GEMINI API) ──
GEMINI_API_KEY="your-google-gemini-api-key"

# ── 4. PRODUCTION URLS ──
APP_URL="https://hoctructuyen.tinhocgenz.io.vn"
VITE_APP_URL="https://hoctructuyen.tinhocgenz.io.vn"

# ── 5. ZALO OPENAPI & ZBS OFFICIAL INTEGRATION (SERVER-ONLY) ──
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_ZBS_TEMPLATE_ID=

# ── 6. FEATURE FLAGS & SAFETY CONTROLS ──
ZALO_INTEGRATION_ENABLED=true
ZALO_SEND_ENABLED=false
ZALO_AUTOMATION_ENABLED=false

# ── 7. SUPABASE BACKEND (SERVERLESS ADMIN) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 8. VERCEL CRON PROTECTION ──
CRON_SECRET=

# ── 9. CLIENT-SIDE SUPABASE (PUBLIC ANON KEYS ONLY) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 10. OPTIONAL WEBHOOK MIRROR FOR SRE / DEVOPS MONITORING ──
WEBHOOK_FORWARD_URL=
