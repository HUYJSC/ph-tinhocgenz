// Prisma Schema for TINHOCGENZ Commercial LMS SaaS
// Database: MySQL 8.x on DirectAdmin Hosting (IP: 103.82.20.110)

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. IDENTITY, ROLES & ACCESS CONTROL (RBAC)
// ==========================================

enum UserRoleType {
  SUPER_ADMIN
  ADMIN
  ACADEMIC_STAFF
  TEACHER
  STUDENT
}

model User {
  id             String       @id @default(uuid())
  email          String?      @unique
  phone          String?      @unique
  username       String       @unique
  fullName       String
  passwordHash   String
  role           UserRoleType @default(STUDENT)
  studentCode    String?      @unique
  teacherCode    String?      @unique
  avatarUrl      String?
  birthYear      Int?
  mustChangePass Boolean      @default(false)
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relationships
  roleAssignments  UserRoleAssignment[]
  enrollments      Enrollment[]
  learningProgress LearningProgress[]
  attendanceLogs   Attendance[]
  examAttempts     ExamAttempt[]
  certificates     Certificate[]
  payments         Payment[]
  notifications    Notification[]
  chatHistories    ChatHistory[]
  auditLogs        AuditLog[]
  teachingClasses  Class[]              @relation("ClassTeacher")

  @@index([role])
  @@index([studentCode])
  @@index([teacherCode])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. 'SUPER_ADMIN', 'ADMIN', 'TEACHER'
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRoleAssignment[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // e.g. 'courses.create', 'finance.read'
  module      String // e.g. 'courses', 'users', 'finance'
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role_assignments")
}

// ==========================================
// 2. COURSES, MODULES, LESSONS & VIDEOS
// ==========================================

model Category {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. 'office', 'ic3', 'ai-skills'
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]

  @@map("categories")
}

model Course {
  id            String   @id @default(uuid())
  code          String   @unique // e.g. 'MOS-WORD-365'
  title         String
  slug          String   @unique
  description   String?
  thumbnailUrl  String?
  categoryId    String
  price         Decimal  @default(0.0) @db.Decimal(12, 2)
  isPublished   Boolean  @default(false)
  level         String   @default("ALL_LEVELS") // BASIC, ADVANCED, ALL_LEVELS
  durationHours Int      @default(12)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category     Category       @relation(fields: [categoryId], references: [id])
  modules      CourseModule[]
  enrollments  Enrollment[]
  classes      Class[]
  exams        Exam[]
  certificates Certificate[]

  @@index([categoryId])
  @@index([isPublished])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, orderIndex])
  @@map("course_modules")
}

enum LessonType {
  VIDEO
  DOCUMENT
  QUIZ
  ASSIGNMENT
}

model Lesson {
  id          String     @id @default(uuid())
  moduleId    String
  title       String
  type        LessonType @default(VIDEO)
  orderIndex  Int        @default(0)
  durationSec Int        @default(0)
  contentBody String?    @db.Text
  documentUrl String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  module   CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  video    Video?
  progress LearningProgress[]

  @@index([moduleId, orderIndex])
  @@map("lessons")
}

model Video {
  id           String   @id @default(uuid())
  lessonId     String   @unique
  videoUrl     String
  provider     String   @default("YOUTUBE") // YOUTUBE, VIMEO, CLOUDFLARE, S3
  durationSec  Int      @default(0)
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("videos")
}

// ==========================================
// 3. ENROLLMENTS & PROGRESS TRACKING
// ==========================================

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  EXPIRED
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([status])
  @@map("enrollments")
}

model LearningProgress {
  id             String    @id @default(uuid())
  userId         String
  lessonId       String
  isCompleted    Boolean   @default(false)
  watchDuration  Int       @default(0) // seconds watched
  completedAt    DateTime?
  lastAccessedAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@map("learning_progress")
}

// ==========================================
// 4. CLASSES & QR/GPS ATTENDANCE
// ==========================================

model Class {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. 'K26-WE01'
  name        String
  courseId    String
  teacherId   String
  room        String   @default("LAB01")
  lat         Float? // Geofence Center Latitude
  lng         Float? // Geofence Center Longitude
  radiusM     Float    @default(5.0) // 5 meters strict geofence
  scheduleDay String? // e.g. "2-4-6" or "3-5-7"
  timeSlot    String? // e.g. "18:00 - 20:00"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course     Course       @relation(fields: [courseId], references: [id])
  teacher    User         @relation("ClassTeacher", fields: [teacherId], references: [id])
  attendance Attendance[]

  @@index([teacherId])
  @@index([courseId])
  @@map("classes")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  MAKEUP
}

model Attendance {
  id          String           @id @default(uuid())
  classId     String
  userId      String
  sessionDate DateTime         @default(now())
  status      AttendanceStatus @default(PRESENT)
  checkInTime DateTime         @default(now())
  method      String           @default("QR_CODE") // QR_CODE, PIN_CODE, MANUAL
  lat         Float?
  lng         Float?
  distanceM   Float?
  ipAddress   String?
  userAgent   String?
  verified    Boolean          @default(true)

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classId, sessionDate])
  @@index([userId, status])
  @@map("attendance")
}

// ==========================================
// 5. EXAMS, QUESTIONS, ANSWERS & ATTEMPTS
// ==========================================

enum ExamType {
  PRACTICE
  FINAL_EXAM
  DIAGNOSTIC
}

model Exam {
  id          String   @id @default(uuid())
  courseId    String?
  title       String
  description String?
  type        ExamType @default(PRACTICE)
  durationMin Int      @default(45)
  passScore   Float    @default(80.0) // 80% passing
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course?       @relation(fields: [courseId], references: [id])
  questions Question[]
  attempts  ExamAttempt[]

  @@index([courseId])
  @@map("exams")
}

model Question {
  id           String   @id @default(uuid())
  examId       String
  questionText String   @db.Text
  explanation  String?  @db.Text
  skillTag     String? // e.g. 'VLOOKUP', 'TABLE_FORMATTING'
  orderIndex   Int      @default(0)
  points       Float    @default(1.0)
  createdAt    DateTime @default(now())

  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers        Answer[]
  studentAnswers StudentAnswer[]

  @@index([examId, orderIndex])
  @@map("questions")
}

model Answer {
  id         String  @id @default(uuid())
  questionId String
  answerText String  @db.Text
  isCorrect  Boolean @default(false)
  orderIndex Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("answers")
}

model ExamAttempt {
  id          String    @id @default(uuid())
  examId      String
  userId      String
  score       Float     @default(0.0)
  maxScore    Float     @default(100.0)
  isPassed    Boolean   @default(false)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  exam    Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers StudentAnswer[]

  @@index([userId, isPassed])
  @@index([examId])
  @@map("exam_attempts")
}

model StudentAnswer {
  id         String  @id @default(uuid())
  attemptId  String
  questionId String
  selectedId String?
  isCorrect  Boolean @default(false)

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("student_answers")
}

// ==========================================
// 6. PAYMENTS & TRANSACTIONS
// ==========================================

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(uuid())
  userId        String
  orderCode     String        @unique // e.g. 'PAY-1727443820'
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("VND")
  method        String        @default("QR_BANKING") // QR_BANKING, VNPAY, MOMO
  status        PaymentStatus @default(PENDING)
  transactionId String?
  note          String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([orderCode])
  @@map("payments")
}

// ==========================================
// 7. DIGITAL CERTIFICATES
// ==========================================

enum CertificateStatus {
  ISSUED
  REVOKED
  EXPIRED
}

model Certificate {
  id               String            @id @default(uuid())
  certificateCode  String            @unique // e.g. 'CERT-2026-WE992'
  userId           String
  courseId         String
  issuedDate       DateTime          @default(now())
  status           CertificateStatus @default(ISSUED)
  templateId       String            @default("royal_gold")
  sha256Hash       String
  revocationReason String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([certificateCode])
  @@map("certificates")
}

// ==========================================
// 8. NOTIFICATIONS & PUSH
// ==========================================

enum NotificationType {
  SYSTEM
  CLASS_REMINDER
  ATTENDANCE_ALERT
  EXAM_RESULT
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ==========================================
// 9. AI CHAT HISTORY & TUTORING SESSIONS
// ==========================================

model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  prompt    String   @db.Text
  response  String   @db.Text
  mode      String   @default("EXPLAIN") // EXPLAIN, HINT, QUIZ
  tokens    Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_history")
}

// ==========================================
// 10. SYSTEM AUDIT LOGS
// ==========================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String // e.g. 'USER_LOGIN', 'GRADE_CHANGED', 'QR_SESSION_OPEN'
  resource  String // e.g. 'ATTENDANCE', 'EXAM', 'PERMISSION'
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId])
  @@map("audit_logs")
}
